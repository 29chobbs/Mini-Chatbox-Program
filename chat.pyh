name = input("Hello, what is your name?")
print("It's very nice to meet you," + name)
food = input("What is your favorite food?")
print("Great choice! I love" + food)
movie = input("What is one of your favorite movies?")
print("Interesting... I haven't heard of " + movie)
color = input("What is your favorite color?")
print("Cool! I like maroon.")
print("So, let's summarize wht you told me.")
print(f"{name}, your favorite food is {food}, your favorite movie is {movie}, and your favorite color is {color}? Awesome! Glad I got to know you!")
